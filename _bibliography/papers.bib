@inproceedings{phelps2026asgsr,
  abbr={ASGSR},
  title={Adapting an Open Source Random Positioning Machine for Mid-Experiment Fluid Integration in Ground-Based Spaceflight Validation Experiments},
  author={Phelps, Madeline and Brennan, Catriona and Juran, Cassandra and Ahmed, Noorsher and Gupta, Anjali},
  booktitle={42nd Annual Meeting of the American Society for Gravitational and Space Research},
  location={Crystal City, VA},
  year={2026},
  month={dec},
  note={Abstract 204. Upcoming presentation.},
  abstract={Random Positioning Machines (RPMs) are an important tool for preparing life science experiments for spaceflight. Off-the-shelf versions are available commercially, but the high price tag and non-adjustable form factor may prevent university labs or funding-constrained projects from utilizing these machines for terrestrial experiment validation. Open source RPM designs are an alternative and can be adapted into more complicated designs. ANTA Biotech modified the Core Electronics open-source RPM to include a fluidics passthrough using only readily accessible commercial off-the-shelf (COTS) components and PLA 3D printed parts. This enabled integration of fluids during active rotation, thus eliminating the need to halt the RPM to add reagents. A gravity vector trace model coupled with a heat density plot built in Python was used to verify the random walk algorithm used to simulate reduced gravity. Cumulative acceleration measurements on the customized RPM confirmed a cumulative effective gravity of 0.06 g in 10 minutes. These results demonstrate that open source hardware, built with COTS components and accessible fabrication methods, can be adapted to meet the operational demands of biological experiment validation for spaceflight without the cost and rigidity of commercial alternatives.},
  bibtex_show={true}
}

@inproceedings{phelps2026cospar,
  abbr={COSPAR},
  title={Adaptation of Open Source RPM Design for Spaceflight Experiments},
  author={Phelps, Madeline and Brennan, Catriona and Juran, Cassandra and Ahmed, Noorsher and Gupta, Anjali},
  booktitle={46th COSPAR Scientific Assembly},
  location={Florence, Italy},
  year={2026},
  month={aug},
  note={Abstract G0.1-0013-26},
  html={https://www.cospar-assembly.org/user/download.php?id=39359&type=abstract&section=congressbrowser},
  abstract={Random Positioning Machines (RPMs) are an important and well utilized technology for preparing life science experiments for spaceflight with off-the-shelf versions available via various commercial companies. While this advancement provides an access point for users to move into spaceflight experiment testing, the high price tag and non-adjustable form factor may prevent university labs or funding-constrained projects from verifying their experiments. Open source RPM designs are a fantastic alternative as an entry point for spaceflight readiness testing without the exorbitant costs. Using Core Electronics as a foundation model, ANTA Biotech has developed an open source RPM that includes a fluidics passthrough to perform spaceflight readiness experiments. With a gravity vector trace model coupled with a heat density plot built in Python, the random walk algorithm is shown to demonstrate sufficient randomness, achieving 0.24 g confirmed via accelerometer readings. The design has been successfully scaled to accommodate more complicated payload setups using only readily accessible commercial off-the-shelf (COTS) components and PLA 3D printed parts including the fluidics passthrough. The accessibility of open source designs enables more rapid knowledge gain which allows funding-constrained projects to verify their science quickly and cost-effectively. This democratizes access and accelerates innovation in the field of microgravity research.},
  bibtex_show={true},
  selected={true}
}

@inproceedings{phelps2026recovery,
  abbr={AIAA},
  title={Design and Test of Dual Deployment Recovery System for Collegiate High-Powered Liquid Rocketry},
  author={Phelps, Madeline and Soriano, Metztli and Ruiz, Emily},
  booktitle={AIAA SciTech 2026 Forum},
  location={Orlando, FL},
  year={2026},
  month={jan},
  note={AIAA 2026-1063},
  doi={10.2514/6.2026-1063},
  abstract={The Students for the Exploration and Development of Space (SEDS) chapter at the University of California, San Diego (UCSD) is actively developing a reliable, reusable large-scale recovery system for liquid bi-propellant sounding rockets, targeting a safe descent rate of 90 ft/s under a drogue parachute and 15 ft/s under a main parachute. The recovery system comprises a single separation, dual deployment system utilizing FFF grain size black powder as a deployment method. Through demonstration of proper design around forces such as ejection forces, parachute line moments, and parachute inflation shock and proper testing of each component in pull tests, pop tests, and a solid demonstrator, risks associated with high power rocket recovery systems can be reduced to anomalies, enabling collegiate teams to launch with higher frequency and reliability. The objective of this paper is to detail the design and testing process of a robust recovery system specialized for single-separation, dual-deployment vehicles to reduce failures and increase confidence during collegiate team launches.},
  bibtex_show={true},
  selected={true}
}